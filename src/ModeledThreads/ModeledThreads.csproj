<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Inventor 2025-2027 all load .NET Framework 4.8 add-ins. The .NET
         Framework is on every Windows machine already, so the add-in needs no
         runtime of its own. -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <AssemblyName>ModeledThreads</AssemblyName>
    <RootNamespace>ModeledThreads</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The API the add-in is compiled against (2025, 2026 or 2027). Build
         against 2025, the oldest supported, so one DLL runs on all three. -->
    <InventorVersion Condition="'$(InventorVersion)' == ''">2025</InventorVersion>
    <!-- Reference the exact interop assembly from refs/<version>, or point
         InventorInteropDir at an installed Inventor's Bin folder. Without either,
         the Autodesk.Inventor.Sdk NuGet package is used. -->
    <InventorInteropDir Condition="'$(InventorInteropDir)' == '' and Exists('$(MSBuildThisFileDirectory)../../refs/$(InventorVersion)/Autodesk.Inventor.Interop.dll')">$(MSBuildThisFileDirectory)../../refs/$(InventorVersion)</InventorInteropDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(InventorInteropDir)' != ''">
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorInteropDir)/Autodesk.Inventor.Interop.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(InventorInteropDir)' == ''">
    <!-- refs/ carries the interop, so the check below only fires when it is
         missing. There is no NuGet fallback worth having: the package on offer
         targets .NET 8 add-ins and cannot build a .NET Framework 4.8 one. -->
  </ItemGroup>

  <Target Name="CheckInventorInterop" BeforeTargets="PrepareForBuild"
          Condition="'$(InventorInteropDir)' == ''">
    <Error Text="No Inventor interop for $(InventorVersion): expected refs/$(InventorVersion)/Autodesk.Inventor.Interop.dll. Restore that folder, or pass -p:InventorInteropDir=&lt;folder&gt;." />
  </Target>

  <ItemGroup>
    <!-- Late binding to the feature types, which the interop gives no shared base. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reference assemblies for .NET Framework 4.8, so the add-in can be
         built on any machine, not only on Windows. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

</Project>
